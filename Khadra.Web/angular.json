{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "khadra-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "kh",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/manrope/400.css",
              "node_modules/@fontsource/manrope/500.css",
              "node_modules/@fontsource/manrope/600.css",
              "node_modules/@fontsource/manrope/700.css",
              "node_modules/@fontsource/manrope/800.css",
              "node_modules/@fontsource/noto-kufi-arabic/400.css",
              "node_modules/@fontsource/noto-kufi-arabic/500.css",
              "node_modules/@fontsource/noto-kufi-arabic/600.css",
              "node_modules/@fontsource/noto-kufi-arabic/700.css",
              "node_modules/leaflet/dist/leaflet.css",
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "localhost",
                "127.0.0.1"
              ]
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "allowedCommonJsDependencies": [
              "leaflet",
              "qrcode",
              "dijkstrajs",
              "pngjs"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "khadra-web:build:production"
            },
            "development": {
              "buildTarget": "khadra-web:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4400,
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
