{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KnownProxies": [],
  "Authentication": {
    "Jwt": {
      "Issuer": "Khadra",
      "Audience": "khadra-api",
      "AccessTokenMinutes": 15
    },
    "Policy": {
      "RefreshTokenDays": 14,
      "RefreshFamilyDays": 30,
      "EmailVerificationHours": 24,
      "PasswordResetMinutes": 60,
      "EmployeeInvitationDays": 7,
      "PasswordMinimumLength": 8,
      "BcryptWorkFactor": 12
    }
  },
  "Email": {
    "Provider": "Logging",
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "FromAddress": "no-reply@khadra.jo",
    "FromName": "Khadra"
  },
  "App": {
    "ClientBaseUrl": "https://localhost:7243",
    "AllowedOrigins": []
  },
  "Database": {
    "AutoMigrate": false
  },
  "Documents": {
    "RootPath": "App_Data/documents",
    "MaximumSizeBytes": 8388608,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "application/pdf" ],
    "LinkLifetimeMinutes": 5
  },
  "AdminDashboard": {
    "SlaWarningThreshold": 0.75,
    "TrendDays": 14,
    "ActivityFeedSize": 7,
    "ResolvedDisputeWindowDays": 30,
    "ReportingTimeZone": "Asia/Amman"
  },
  "DealerConsole": {
    "UpcomingWindowHours": 48,
    "ReportingWeekStart": "Sunday"
  },
  "BusinessRules": {
    "CommissionPercent": 20,
    "DepositPercent": 20,
    "NoShowTimeoutHours": 8,
    "DeliveryFeeJod": 10,
    "DealerNonDeliveryPenaltyMinPercent": 25,
    "DealerNonDeliveryPenaltyMaxPercent": 50,
    "FreeCancellationWindowMinutes": 60,
    "AdminSlaHours": 48,
    "CustomerCancellationPenaltyPercent": 100,
    "PaymentWindowMinutes": 20,
    "PostReturnSettlementHours": 48,
    "MinimumRenterAge": 21
  }
}
