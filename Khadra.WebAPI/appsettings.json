{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Addresses the API will accept X-Forwarded-For from — in practice the BFF's. That header decides
  // the rate limiter's partition key, so anything trusted here can choose its own limit bucket:
  // name the proxy and nothing else. An empty list is REFUSED at startup outside Development,
  // because empty makes ForwardedHeadersMiddleware trust every caller rather than none.
  "KnownProxies": [],
  "Authentication": {
    "Jwt": {
      "Issuer": "Khadra",
      "Audience": "khadra-api",
      "AccessTokenMinutes": 15
    },
    "Policy": {
      "RefreshTokenDays": 14,
      "RefreshFamilyDays": 30,
      "RefreshReuseGraceSeconds": 60,
      "EmailVerificationHours": 24,
      "PasswordResetMinutes": 60,
      "EmployeeInvitationDays": 7,
      "PasswordMinimumLength": 8,
      "BcryptWorkFactor": 12
    }
  },
  "Email": {
    "Provider": "Logging",
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "FromAddress": "no-reply@khadra.jo",
    "FromName": "Khadra"
  },
  "App": {
    "ClientBaseUrl": "https://localhost:7243",
    "AllowedOrigins": []
  },
  // Who is invited to administer a platform that has never had an administrator. Empty here on
  // purpose — real values belong in appsettings.Local.json, user-secrets or the environment. There
  // is no password: the invitation is emailed and the account does nothing until it is accepted.
  "Admin": {
    "Bootstrap": {
      "Email": "",
      "Phone": "",
      "FullName": ""
    }
  },
  "Database": {
    "AutoMigrate": false
  },
  "Documents": {
    "RootPath": "App_Data/documents",
    "MaximumSizeBytes": 8388608,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "application/pdf" ],
    "LinkLifetimeMinutes": 5
  },
  "AdminDashboard": {
    "SlaWarningThreshold": 0.75,
    "TrendDays": 14,
    "ActivityFeedSize": 7,
    "ResolvedDisputeWindowDays": 30,
    "ReportingTimeZone": "Asia/Amman"
  },
  "DealerConsole": {
    "UpcomingWindowHours": 48,
    "ReportingWeekStart": "Sunday"
  },
  "BusinessRules": {
    "CommissionPercent": 20,
    "DepositPercent": 20,
    "NoShowTimeoutHours": 8,
    "DealerNonDeliveryPenaltyMinPercent": 25,
    "DealerNonDeliveryPenaltyMaxPercent": 50,
    "FreeCancellationWindowMinutes": 60,
    "AdminSlaHours": 48,
    "CustomerCancellationPenaltyPercent": 100,
    "PaymentWindowHours": 24,
    "BookingAnswerWindowHours": 48,
    "PostReturnSettlementHours": 48,
    "TurnaroundMinutes": 120,
    "MaxAdvanceBookingDays": 180,
    "MinimumBookingLeadTimeMinutes": 120,
    "MaxRentalDays": 90,
    "MinimumRenterAge": 21,
    "EarliestVehicleModelYear": 1970
  }
}
