{
  // The BFF reaches the API over loopback on a developer machine. Naming it here rather than
  // defaulting in code keeps one source of truth for who may set X-Forwarded-For, and makes
  // development take the same path through Program.cs that production takes.
  "KnownProxies": [ "127.0.0.1", "::1" ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  // Real delivery through Brevoâ€™s SMTP relay.
  //
  // Chosen over Resend because Brevo verifies a single SENDER ADDRESS rather than a whole domain,
  // so mail can reach any recipient without owning a domain yet. Resend refuses every address
  // except the account owner until a domain is verified, which closed sign-up to everyone else.
  // Switch to Resend (or a verified domain on either) when the platformâ€™s domain is ready â€” mail
  // from your own domain with SPF and DKIM is far less likely to be filtered as spam.
  //
  // Only the transport is here. The login, the SMTP key and the sender address are personal or
  // secret and live in appsettings.Local.json, which is gitignored.
  //
  // To go back to Resend: set Provider to "Resend" and put Email:ApiKey and
  // Email:FromAddress (onboarding@resend.dev) in appsettings.Local.json.
  "Email": {
    "Provider": "Smtp",
    "Host": "smtp-relay.brevo.com",
    "Port": 587,
    "UseStartTls": true,
    "FromName": "Khadra"
  },
  "App": {
    // The console, not the BFF. In development the dashboard is served by `ng serve` on 4200 and the
    // BFF has no wwwroot at all, so every emailed link â€” verify-email, reset-password,
    // accept-invitation â€” pointed at a URL that answered 404. In production the BFF serves the built
    // dashboard and this is the site's own origin again.
    "ClientBaseUrl": "http://localhost:4200",
    // 4200 is the console under `ng serve`. 4300 is the customer app: Flutter builds one codebase
    // for Android, iOS and web, and the web build is what can be driven end to end on this machine.
    // A real phone talks to the API directly and is not subject to CORS at all, so this entry exists
    // for development only and has no production counterpart.
    // This machine's own address on the Wi-Fi is NOT listed: it is a DHCP lease and it moves. See
    // IsLocalNetworkAppOrigin in Program.cs, which accepts any private address on port 4300 in
    // development, so opening the customer app on a real phone survives the lease changing.
    "AllowedOrigins": ["http://localhost:4200", "http://localhost:4300"]
  },
  "Database": {
    "AutoMigrate": true
  }
}

