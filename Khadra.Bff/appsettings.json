{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BffSecurity": {
    "ApiBaseUrl": "http://khadra-webapi:8080/",
    "SessionAbsoluteHours": 8,
    "SessionIdleMinutes": 30
  },
  "ReverseProxy": {
    "Routes": {
      "auth-register": {
        "ClusterId": "webapi",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/auth/register",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-verify-email": {
        "ClusterId": "webapi",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/auth/verify-email",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-resend-verification": {
        "ClusterId": "webapi",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/auth/resend-verification",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-forgot-password": {
        "ClusterId": "webapi",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/auth/forgot-password",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-reset-password": {
        "ClusterId": "webapi",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/auth/reset-password",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-accept-invitation": {
        "ClusterId": "webapi",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/auth/accept-invitation",
          "Methods": [
            "POST"
          ]
        }
      },
      "api": {
        "ClusterId": "webapi",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "webapi": {
        "Destinations": {
          "primary": {
            "Address": "http://khadra-webapi:8080/"
          }
        }
      }
    }
  }
}
