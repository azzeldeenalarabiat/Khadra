{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BffSecurity": {
    "ApiBaseUrl": "http://khadra-webapi:8080/",
    "Deployment": "console"
  },
  "ReverseProxy": {
    "Clusters": {
      "webapi": {
        "Destinations": {
          "primary": {
            "Address": "http://khadra-webapi:8080/"
          }
        }
      }
    }
  }
}
