<?xml version="1.0" encoding="utf-8"?>
<!--
  THE DEVELOPMENT configuration. Merged into DEBUG builds only, where it replaces the release file
  in `src/main/res/xml/` of the same name. It cannot reach a release APK, which is the whole point
  of it living here: a production build was found carrying these addresses, and moving the list is
  what makes that impossible rather than merely unlikely.

  It names DEVELOPMENT hosts only — a machine on a local network, the Android emulator's alias for
  its host, and loopback — so a debug build can be pointed at a laptop running the API while every
  other destination, including the real one, still requires HTTPS.

  Nothing here is a production allowance: KHADRA_API_BASE_URL has no compiled-in production default
  (see lib/core/config/app_environment.dart), so a release pointed at the real API is an https://
  address and never consults an entry in any of these files.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The emulator's alias for the host it runs on. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>

        <!-- A developer machine on the local Wi-Fi, named one address at a time.
             Android's network security config has no notion of an address RANGE,
             so a DHCP lease that moves — as it did, from .251 to .254, mid-test —
             means editing this list and rebuilding.

             That is a real limitation of testing a native build against a laptop,
             and the reason the WEB build derives its host from the page instead
             (see lib/core/config/app_environment.dart). Add the address printed
             by `ipconfig` when the lease moves. -->
        <domain includeSubdomains="false">192.168.8.254</domain>
        <domain includeSubdomains="false">192.168.1.156</domain>
    </domain-config>
</network-security-config>
